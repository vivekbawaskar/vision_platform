# Copy to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# mysql  : use MySQL (default)
# sqlite : use a local file, no server needed (good for hosted demos)
# auto   : try MySQL, fall back to SQLite if it is unreachable
DB_BACKEND=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vision_platform
DB_PORT=3306

# --- Optional tuning ---------------------------------------------------------
# DB_POOL_SIZE=5
# DB_SSL_CA=/path/to/ca.pem        # required by some managed MySQL providers
# SQLITE_PATH=vision_platform.db
# MODEL_PATH=yolov8n.pt
# LOG_INTERVAL_SECONDS=1.0
# SAMPLE_VIDEO_PATH=sample.mp4
# DEFAULT_SOURCE=Webcam            # Webcam | Sample Video | Upload Video | RTSP Stream
# MAX_DISPLAY_WIDTH=960
